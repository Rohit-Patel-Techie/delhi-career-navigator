# ============================================
# DELHI CAREER NAVIGATOR - AI CONFIGURATION
# ============================================

# -------------------- AI PROVIDER --------------------
# Choose which AI provider to use:
#   - ollama  = Local Ollama (free, no internet needed)
#   - gemini  = Google Gemini API (requires API key)
#   - mock    = Fake data (for testing, no AI)
#
# Uncomment ONE of the following lines:

AI_PROVIDER=ollama
# AI_PROVIDER=gemini

# -------------------- MOCK MODE --------------------
# Set to 'true' to use fake data (overrides AI_PROVIDER)
# Useful for frontend testing without AI

USE_MOCK_AI=false
# USE_MOCK_AI=true

# -------------------- OLLAMA SETTINGS --------------------
# Only needed if AI_PROVIDER=ollama
# Run `ollama list` to see available models

OLLAMA_MODEL=mistral-nemo:latest
# OLLAMA_MODEL=devstral:latest
# OLLAMA_MODEL=llama3:latest

# -------------------- GEMINI SETTINGS --------------------
# Only needed if AI_PROVIDER=gemini
# Get your API key from: https://aistudio.google.com/

GEMINI_API_KEY=AIzaSyC2uU75Lhd0z_q1DWV7y5Y_G1EtqQ8BuIQ
